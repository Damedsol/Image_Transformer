{
	"name": "imagetransformer",
	"private": true,
	"version": "1.3.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"lint": "oxlint . --fix && ls-lint",
		"format": "biome format --write .",
		"prepare": "husky",
		"type-check": "tsc --noEmit",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@ls-lint/ls-lint": "catalog:",
		"@vitest/ui": "^4.1.10",
		"globals": "catalog:",
		"husky": "catalog:",
		"jsdom": "^29.1.1",
		"lint-staged": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"dependencies": {
		"lucide": "^1.24.0"
	}
}
