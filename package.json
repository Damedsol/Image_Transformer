{
	"name": "imagetransformer",
	"private": true,
	"version": "1.2.3",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "oxlint . --fix && ls-lint",
		"format": "biome format --write .",
		"prepare": "husky",
		"type-check": "tsc --noEmit",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@ls-lint/ls-lint": "catalog:",
		"globals": "catalog:",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	}
}
