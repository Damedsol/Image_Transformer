{
	"name": "image-transformer-backend",
	"version": "2.0.0",
	"license": "CC-BY-4.0",
	"description": "Backend para convertir imágenes usando Sharp",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch --clear-screen=false src/index.ts",
		"test": "jest",
		"lint": "oxlint --fix",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"archiver": "7.0.1",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"express-rate-limit": "8.3.2",
		"helmet": "8.1.0",
		"multer": "2.3.0",
		"pino": "10.3.1",
		"sharp": "0.35.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/archiver": "7.0.0",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/multer": "2.2.0",
		"@types/node": "25.6.0",
		"oxlint": "catalog:",
		"pino-pretty": "13.1.3",
		"tsx": "4.21.0",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	}
}
